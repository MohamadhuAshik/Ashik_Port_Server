# Server Port
PORT=5000

# SMTP Provider Settings
# For Gmail: host=smtp.gmail.com, port=465, secure=true (or port=587, secure=false)
# Use Google App Password (16 characters) - not your normal password!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# SMTP Credentials
SMTP_USER=mohamadhuashik@gmail.com
SMTP_PASS=your_16_character_app_password_here

# Recipient Email (where contact messages will arrive)
RECEIVER_EMAIL=mohamadhuashik@gmail.com

# Sender Display Name
SENDER_NAME="Mohamadhu Ashik Portfolio"

# Allowed CORS origins (comma-separated or * for all)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,*
